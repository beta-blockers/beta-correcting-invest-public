{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "News addon configuration",
  "description": "Structure only: required and forbidden members, types, enumerations, string patterns, and length and count limits. A document this schema accepts can still be refused by the engine, because the engine's relational and time-based rules cannot be expressed here; the Python validator in public_pilot is authoritative. Not expressed here: monitor_from must not be later than epoch_end; calendar dates and the existence of the time zone; with a payload, the same package_id, symbols within its universe, and epoch_end no later than valid_until. The file holds no thresholds, prompts or scoring rules. Authoritative: public_pilot.newsconfig, run by `public-pilot validate-news-config`.",
  "$comment": "Patterns end in $(?!\\n) so that regular-expression engines whose $ also matches before a final newline still require a whole-string match. JSON Schema counts 1.0 as an integer; the engine requires integer literals.",
  "type": "object",
  "required": [
    "product_id",
    "package_id",
    "monitor_from",
    "epoch_end",
    "timezone",
    "symbols",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
    },
    "monitor_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?!\\n)"
    },
    "epoch_end": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?!\\n)"
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]{0,31}(/[A-Za-z0-9_+-]{1,32}){0,2}$(?!\\n)"
    },
    "symbols": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.-]{0,9}$(?!\\n)"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "cik",
          "aliases"
        ],
        "additionalProperties": false,
        "properties": {
          "cik": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999999999
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$(?!\\n)"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
