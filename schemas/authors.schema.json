{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog of authors and their public keys",
  "description": "Structure only: required and forbidden members, types, enumerations, string patterns, and length and count limits. A document this schema accepts can still be refused by the engine, because the engine's relational and time-based rules cannot be expressed here; the Python validator in public_pilot is authoritative. Not expressed here: unique author IDs, key IDs and public keys; that each fingerprint is the SHA-256 of its key; that a key's packages are products of its author; calendar validity of valid_from; the append-only rule. Authoritative: public_pilot.catalog, run by `public-pilot catalog check`.",
  "$comment": "Patterns end in $(?!\\n) so that regular-expression engines whose $ also matches before a final newline still require a whole-string match. JSON Schema counts 1.0 as an integer; the engine requires integer literals.",
  "type": "object",
  "required": [
    "format",
    "authors"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "public-pilot-authors-v1"
    },
    "authors": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "author_id",
          "display_name",
          "keys"
        ],
        "additionalProperties": false,
        "properties": {
          "author_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "key_id",
                "public_key",
                "fingerprint_sha256",
                "status",
                "valid_from",
                "packages"
              ],
              "additionalProperties": false,
              "properties": {
                "key_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
                },
                "public_key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$(?!\\n)"
                },
                "fingerprint_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$(?!\\n)"
                },
                "status": {
                  "enum": [
                    "active",
                    "retired",
                    "revoked"
                  ]
                },
                "valid_from": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?!\\n)"
                },
                "packages": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
