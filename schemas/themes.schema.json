{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog of themes",
  "description": "Structure only: required and forbidden members, types, enumerations, string patterns, and length and count limits. A document this schema accepts can still be refused by the engine, because the engine's relational and time-based rules cannot be expressed here; the Python validator in public_pilot is authoritative. Not expressed here: unique theme IDs; calendar validity of committed_on; that every author and product resolves; that latest_public_quarter is the latest quarter under history/ for the theme's products. Authoritative: public_pilot.catalog, run by `public-pilot catalog check`.",
  "$comment": "Patterns end in $(?!\\n) so that regular-expression engines whose $ also matches before a final newline still require a whole-string match. JSON Schema counts 1.0 as an integer; the engine requires integer literals.",
  "type": "object",
  "required": [
    "format",
    "themes"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "public-pilot-themes-v1"
    },
    "themes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "theme_id",
          "title",
          "geographies",
          "policy_ids",
          "status",
          "author_ids",
          "product_ids",
          "committed_on",
          "latest_public_quarter"
        ],
        "additionalProperties": false,
        "properties": {
          "theme_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "geographies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "policy_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "status": {
            "enum": [
              "researched",
              "in_progress",
              "committed"
            ]
          },
          "author_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
            }
          },
          "product_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$(?!\\n)"
            }
          },
          "committed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?!\\n)"
          },
          "latest_public_quarter": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-Q[1-4]$(?!\\n)"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
