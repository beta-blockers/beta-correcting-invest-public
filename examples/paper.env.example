# Copy outside Git (for example to ~/.config/public-pilot/paper.env), chmod 600, then edit locally.
APCA_API_KEY_ID=REPLACE_WITH_YOUR_PAPER_KEY
APCA_API_SECRET_KEY=REPLACE_WITH_YOUR_PAPER_SECRET
PILOT_ACCOUNT_ID=REPLACE_WITH_YOUR_PAPER_ACCOUNT_ID
PILOT_ALLOCATION=1000
PILOT_MAX_ORDER=1000
PILOT_MAX_TURNOVER=1000
PILOT_MAX_WEIGHT=0.5
